{
	"schemaVersion": 1,
	"id": "arenaagents",
	"version": "${version}",
	"name": "Arena Agents",
	"description": "Summon configurable Codex-powered humanoid agents that can act autonomously in Minecraft.",
	"icon": "assets/arenaagents/icon.png",
	"license": "All-Rights-Reserved",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.agaminggod.arenaagents.ArenaAgents"
		],
		"client": [
			"dev.agaminggod.arenaagents.client.ArenaAgentsClient"
		]
	},
	"mixins": [
		"arenaagents.mixins.json",
